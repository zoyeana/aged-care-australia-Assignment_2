{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 520,
  "data": {
    "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart02_australia_population_pyramid_1980_2025.csv"
  },
  "params": [
    {
      "name": "Year_selected",
      "value": 2025,
      "bind": {"input": "range", "min": 1980, "max": 2025, "step": 1, "name": "Year: "}
    }
  ],
  "transform": [
    {"calculate": "parseInt(datum.AgeGroup)", "as": "Age Start"},
    {"calculate": "datum.Sex == 'Male' ? -datum.Population : datum.Population", "as": "Signed Population"},
    {"calculate": "datum['Age Start'] >= 65 ? datum.Population : 0", "as": "Aged 65+ Population"},
    {
      "joinaggregate": [
        {"op": "sum", "field": "Population", "as": "Total Population"},
        {"op": "sum", "field": "Aged 65+ Population", "as": "Total Aged 65+"}
      ],
      "groupby": ["Year"]
    },
    {"calculate": "datum['Total Aged 65+'] / datum['Total Population'] * 100", "as": "Pct 65+"},
    {"calculate": "datum.Population / datum['Total Population'] * 100", "as": "Share of Population"}
  ],
  "encoding": {
    "y": {
      "field": "AgeGroup",
      "type": "ordinal",
      "sort": ["100+", "95–99", "90–94", "85–89", "80–84", "75–79", "70–74", "65–69", "60–64", "55–59", "50–54", "45–49", "40–44", "35–39", "30–34", "25–29", "20–24", "15–19", "10–14", "5–9", "0–4"],
      "axis": {"title": "Age group (years)", "labelFontSize": 12}
    },
    "x": {
      "field": "Signed Population",
      "type": "quantitative",
      "scale": {"domain": [-1100000, 1100000]},
      "axis": {
        "title": "Number of people (millions)    ← Males | Females →",
        "values": [-1000000, -500000, 0, 500000, 1000000],
        "labelExpr": "format(abs(datum.value) / 1000000, '.1f')",
        "grid": true
      }
    }
  },
  "layer": [
    {
      "transform": [{"filter": "datum.Year == Year_selected"}],
      "mark": {"type": "bar", "height": {"band": 0.8}},
      "encoding": {
        "color": {
          "field": "Sex",
          "type": "nominal",
          "scale": {"domain": ["Male", "Female"], "range": ["#0072B2", "#E69F00"]},
          "legend": {"title": null, "orient": "top", "symbolType": "square"}
        },
        "opacity": {
          "condition": {"test": "datum['Age Start'] >= 65", "value": 1},
          "value": 0.55
        },
        "tooltip": [
          {"field": "Year", "type": "quantitative", "format": "d"},
          {"field": "AgeGroup", "type": "nominal", "title": "Age group"},
          {"field": "Sex", "type": "nominal"},
          {"field": "Population", "type": "quantitative", "format": ","},
          {"field": "Share of Population", "type": "quantitative", "format": ".1f", "title": "Share of all Australians (%)"},
          {"field": "Pct 65+", "type": "quantitative", "format": ".1f", "title": "Aged 65+ that year (%)"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#142D4E",
      "titleColor": "#142D4E",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "gridColor": "#E6EAF0"
    },
    "legend": {"labelColor": "#142D4E", "labelFontSize": 13}
  }
}
