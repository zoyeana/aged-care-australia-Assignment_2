{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "padding": {"left": 8, "right": 8, "top": 16, "bottom": 8},
  "autosize": {"type": "fit", "contains": "padding"},
  "background": "#FFFFFF",
  "data": {
    "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart01_ageing_population.csv"
  },
  "transform": [
    {
      "calculate": "datum.Year == 1980 ? 'Starting point (0%)' : '+' + format(datum['Growth Pct'], ',.1f') + '%'",
      "as": "Growth Label"
    },
    {
      "calculate": "'+' + format(datum['Growth Pct'], ',.0f') + '%'",
      "as": "Growth Short"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {"domain": [1980, 2038], "zero": false, "nice": false},
      "axis": {
        "title": null,
        "values": [1980, 1990, 2000, 2010, 2020, 2025],
        "format": "d",
        "grid": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "description": "Vertical guide line that follows the hovered year",
      "transform": [{"filter": {"param": "hover", "empty": false}}],
      "mark": {"type": "rule", "color": "#142D4E", "strokeWidth": 1, "opacity": 0.35},
      "encoding": {
        "x": {"field": "Year", "type": "quantitative"}
      }
    },
    {
      "description": "The two lines",
      "mark": {"type": "line", "strokeWidth": 3.5, "strokeCap": "round", "interpolate": "monotone"},
      "encoding": {
        "y": {
          "field": "Growth Pct",
          "type": "quantitative",
          "scale": {"domain": [0, 560]},
          "axis": {
            "title": "Growth in population since 1980",
            "values": [0, 100, 200, 300, 400, 500],
            "labelExpr": "datum.value == 0 ? '0%' : '+' + datum.value + '%'"
          }
        },
        "color": {
          "field": "Age Group",
          "type": "nominal",
          "scale": {
            "domain": ["Aged 65–84", "Aged 85+"],
            "range": ["#0072B2", "#E69F00"]
          },
          "legend": null
        },
        "strokeDash": {
          "field": "Age Group",
          "type": "nominal",
          "scale": {
            "domain": ["Aged 65–84", "Aged 85+"],
            "range": [[1, 0], [7, 5]]
          },
          "legend": null
        }
      }
    },
    {
      "description": "Invisible points that catch the mouse and show tooltips",
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["Year"],
            "nearest": true,
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {"type": "point", "filled": true, "size": 90, "stroke": "#FFFFFF", "strokeWidth": 2},
      "encoding": {
        "y": {"field": "Growth Pct", "type": "quantitative"},
        "color": {
          "field": "Age Group",
          "type": "nominal",
          "scale": {"domain": ["Aged 65–84", "Aged 85+"], "range": ["#0072B2", "#E69F00"]},
          "legend": null
        },
        "opacity": {
          "condition": {"param": "hover", "empty": false, "value": 1},
          "value": 0
        },
        "tooltip": [
          {"field": "Age Group", "type": "nominal", "title": "Age group"},
          {"field": "Year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "Population", "type": "quantitative", "title": "Number of people", "format": ",d"},
          {"field": "Growth Label", "type": "nominal", "title": "Growth since 1980"}
        ]
      }
    },
    {
      "description": "Coloured dot at the end of each line",
      "transform": [{"filter": "datum.Year == 2025"}],
      "mark": {"type": "point", "filled": true, "size": 110, "stroke": "#FFFFFF", "strokeWidth": 2, "opacity": 1},
      "encoding": {
        "y": {"field": "Growth Pct", "type": "quantitative"},
        "color": {
          "field": "Age Group",
          "type": "nominal",
          "scale": {"domain": ["Aged 65–84", "Aged 85+"], "range": ["#0072B2", "#E69F00"]},
          "legend": null
        }
      }
    },
    {
      "description": "End label: age group name",
      "transform": [{"filter": "datum.Year == 2025"}],
      "mark": {
        "type": "text", "align": "left", "baseline": "middle", "dx": 12, "dy": -16,
        "fontSize": 14, "fontWeight": 700, "color": "#142D4E",
        "font": "Inter, Helvetica, Arial, sans-serif"
      },
      "encoding": {
        "y": {"field": "Growth Pct", "type": "quantitative"},
        "text": {"field": "Age Group", "type": "nominal"}
      }
    },
    {
      "description": "End label: total growth since 1980",
      "transform": [{"filter": "datum.Year == 2025"}],
      "mark": {
        "type": "text", "align": "left", "baseline": "middle", "dx": 12, "dy": 6,
        "fontSize": 24, "fontWeight": 800, "color": "#142D4E",
        "font": "Inter, Helvetica, Arial, sans-serif"
      },
      "encoding": {
        "y": {"field": "Growth Pct", "type": "quantitative"},
        "text": {"field": "Growth Short", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Inter, Helvetica, Arial, sans-serif",
    "axis": {
      "labelColor": "#142D4E",
      "titleColor": "#142D4E",
      "labelFontSize": 13,
      "titleFontSize": 13,
      "titleFontWeight": 600,
      "titlePadding": 12,
      "gridColor": "#E6EAF0",
      "gridWidth": 1,
      "domainColor": "#9AA7B8",
      "tickColor": "#9AA7B8"
    }
  }
}
