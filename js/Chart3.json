{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Which Australian States Have the Oldest Populations?",
    "subtitle": "Share of each state's and territory's residents aged 65 or older, June 2025",
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 14,
    "color": "#142D4E",
    "subtitleColor": "#142D4E",
    "offset": 12
  },
  "width": "container",
  "height": 520,
  "background": "#FFFFFF",
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart03_states_aged65plus_2025.csv"
            },
            "key": "State",
            "fields": [
              "StateCode",
              "TotalPopulation",
              "Population65Plus",
              "Percentage65Plus"
            ]
          }
        },
        {
          "calculate": "datum.Percentage65Plus < 14 ? 'Under 14%' : datum.Percentage65Plus < 17 ? '14% to under 17%' : datum.Percentage65Plus < 19 ? '17% to under 19%' : datum.Percentage65Plus < 21 ? '19% to under 21%' : '21% or more'",
          "as": "Share Group"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "Share Group",
          "type": "ordinal",
          "scale": {
            "domain": [
              "Under 14%",
              "14% to under 17%",
              "17% to under 19%",
              "19% to under 21%",
              "21% or more"
            ],
            "range": [
              "#EAF4FF",
              "#BDDDF3",
              "#80BCE2",
              "#368DC2",
              "#07558C"
            ]
          },
          "legend": {
            "title": "Residents aged 65+",
            "orient": "top-left",
            "titleColor": "#142D4E",
            "labelColor": "#142D4E",
            "titleFontSize": 13,
            "labelFontSize": 12,
            "symbolType": "square",
            "symbolSize": 250,
            "symbolStrokeColor": "#BDC8D6",
            "symbolStrokeWidth": 0.5
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "State / territory"
          },
          {
            "field": "Population65Plus",
            "type": "quantitative",
            "format": ",",
            "title": "Population aged 65+"
          },
          {
            "field": "TotalPopulation",
            "type": "quantitative",
            "format": ",",
            "title": "Total population"
          },
          {
            "field": "Percentage65Plus",
            "type": "quantitative",
            "format": ".1f",
            "title": "Aged 65+ (%)"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "State": "Western Australia",
            "lon": 121.5,
            "lat": -26
          },
          {
            "State": "Northern Territory",
            "lon": 133.4,
            "lat": -19.5
          },
          {
            "State": "South Australia",
            "lon": 135.5,
            "lat": -30
          },
          {
            "State": "Queensland",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "State": "New South Wales",
            "lon": 146.8,
            "lat": -32.2
          },
          {
            "State": "Victoria",
            "lon": 144.2,
            "lat": -37
          },
          {
            "State": "Tasmania",
            "lon": 150.6,
            "lat": -42.2
          },
          {
            "State": "Australian Capital Territory",
            "lon": 152.4,
            "lat": -35.6
          }
        ]
      },
      "transform": [
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart03_states_aged65plus_2025.csv"
            },
            "key": "State",
            "fields": [
              "StateCode",
              "Percentage65Plus"
            ]
          }
        },
        {
          "calculate": "datum.StateCode + '  ' + format(datum.Percentage65Plus, '.1f') + '%'",
          "as": "Label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.Percentage65Plus >= 19 && datum.State != 'Tasmania'",
            "value": "#FFFFFF"
          },
          "value": "#142D4E"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon1": 142.2,
            "lat1": -40.3,
            "lon2": 144.9,
            "lat2": -41.1
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#142D4E",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon1",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat1",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 141.8,
            "lat": -40.3
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#142D4E",
        "text": [
          "More than 1 in 5 Tasmanians",
          "are aged 65 or older."
        ],
        "lineHeight": 18
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 0
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 11,
        "opacity": 0.85,
        "color": "#142D4E",
        "text": [
          "Source: Australian Bureau of Statistics (ABS), National, state and territory population, June 2025.",
          "Boundaries: Natural Earth."
        ],
        "lineHeight": 14
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 520
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Helvetica, Arial, sans-serif"
  }
}
