{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where Is Aged Care Used Across Australia?",
    "subtitle": ["Circle area shows the combined Home, Residential and Flexible care recipients reported in each state or territory, 30 June 2025.", "Counts add the three care types together, so they are not unique individuals. Larger circles do not mean higher demand per person."],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "color": "#142D4E",
    "subtitleColor": "#142D4E",
    "offset": 12
  },
  "width": "container",
  "height": 540,
  "background": "#FFFFFF",
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/australia_states.topojson",
        "format": {"type": "topojson", "feature": "australia_states"}
      },
      "mark": {"type": "geoshape", "fill": "#EAF4FF", "stroke": "#B8CADB", "strokeWidth": 1}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart04_aged_care_proportional_symbol_map_2025.csv"
      },
      "transform": [
        {
          "aggregate": [{"op": "sum", "field": "Recipients", "as": "Total Recipients"}],
          "groupby": ["State", "StateCode", "Latitude", "Longitude"]
        }
      ],
      "mark": {"type": "circle", "fill": "#0072B2", "opacity": 0.75, "stroke": "#FFFFFF", "strokeWidth": 2},
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Total Recipients",
          "type": "quantitative",
          "scale": {"domain": [0, 160000], "range": [0, 2600]},
          "legend": {
            "title": "Combined recipients",
            "values": [5000, 25000, 50000],
            "format": ",d",
            "orient": "top-left",
            "direction": "horizontal",
            "symbolFillColor": "#FFFFFF",
            "symbolStrokeColor": "#142D4E",
            "symbolStrokeWidth": 1,
            "titleColor": "#142D4E",
            "labelColor": "#142D4E",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "order": {"field": "Total Recipients", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "Total Recipients", "type": "quantitative", "format": ",", "title": "Combined care recipients"}
        ]
      }
    },
    {
      "data": {"values": [{"x": 0}]},
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#142D4E",
        "text": ["New South Wales has the highest total:"]
      },
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 405}
      }
    },
    {
      "data": {"values": [{"x": 0}]},
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "color": "#142D4E",
        "lineHeight": 17,
        "text": ["158,314 combined care recipients", "(32% of the national total)"]
      },
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 427}
      }
    },
    {
      "data": {"values": [{"x": 0}]},
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "bottom",
        "fontSize": 11,
        "opacity": 0.85,
        "color": "#142D4E",
        "lineHeight": 14,
        "text": ["Source: Australian Institute of Health and", "Welfare (AIHW), GEN Aged Care Data,", "30 June 2025. Boundaries: Natural Earth."]
      },
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 540}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Inter, Helvetica, Arial, sans-serif"
  }
}
