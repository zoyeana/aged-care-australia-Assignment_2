{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Who Uses Each Type of Aged Care?",
    "subtitle": [
      "Age and sex of people using Home care (left of each panel) and Residential care (right), 30 June 2025.",
      "Bars show each group's share of all recipients of that care type, so women outnumbering men shows up in the bar lengths."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "color": "#142D4E",
    "subtitleColor": "#142D4E",
    "offset": 12
  },
  "background": "#FFFFFF",
  "data": {
    "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart06_home_residential_butterfly_2025.csv"
  },
  "transform": [
    {
      "joinaggregate": [{"op": "sum", "field": "Recipients", "as": "Care Type Total"}],
      "groupby": ["CareType"]
    },
    {
      "calculate": "datum.Recipients / datum['Care Type Total'] * 100",
      "as": "Share of Care Type"
    }
  ],
  "vconcat": [
    {
      "hconcat": [
        {
          "width": 340,
          "height": 380,
          "title": {"text": "Men", "anchor": "middle", "fontSize": 16, "color": "#142D4E", "offset": 28},
          "transform": [
            {"filter": "datum.Sex == 'Male'"},
            {
              "calculate": "datum.CareType == 'Home care' ? -datum['Share of Care Type'] : datum['Share of Care Type']",
              "as": "Signed Share"
            }
          ],
          "layer": [
            {
              "mark": {"type": "bar", "height": {"band": 0.82}},
              "encoding": {
                "y": {
                  "field": "AgeGroup",
                  "type": "ordinal",
                  "sort": {"field": "AgeOrder", "order": "descending"},
                  "axis": {"title": "Age group (years)"}
                },
                "x": {
                  "field": "Signed Share",
                  "type": "quantitative",
                  "scale": {"domain": [-20, 20], "nice": false},
                  "axis": {
                    "title": "Share of all recipients of that care type (%)",
                    "values": [-15, -10, -5, 0, 5, 10, 15],
                    "labelExpr": "format(abs(datum.value), '.0f') + '%'"
                  }
                },
                "color": {
                  "field": "CareType",
                  "type": "nominal",
                  "scale": {"domain": ["Home care", "Residential care"], "range": ["#0072B2", "#E69F00"]},
                  "legend": null
                },
                "tooltip": [
                  {"field": "CareType", "type": "nominal", "title": "Care type"},
                  {"field": "Sex", "type": "nominal"},
                  {"field": "AgeGroup", "type": "nominal", "title": "Age group"},
                  {"field": "Recipients", "type": "quantitative", "format": ","},
                  {"field": "Share of Care Type", "type": "quantitative", "format": ".1f", "title": "Share of all recipients of this care type (%)"}
                ]
              }
            },
            {
              "data": {"values": [{"x": -10, "t": "◄ Home care"}, {"x": 10, "t": "Residential care ►"}]},
              "mark": {"type": "text", "fontSize": 13, "fontWeight": "bold", "color": "#142D4E", "baseline": "bottom"},
              "encoding": {
                "x": {"field": "x", "type": "quantitative"},
                "y": {"value": -6},
                "text": {"field": "t", "type": "nominal"}
              }
            }
          ]
        },
        {
          "width": 340,
          "height": 380,
          "title": {"text": "Women", "anchor": "middle", "fontSize": 16, "color": "#142D4E", "offset": 28},
          "transform": [
            {"filter": "datum.Sex == 'Female'"},
            {
              "calculate": "datum.CareType == 'Home care' ? -datum['Share of Care Type'] : datum['Share of Care Type']",
              "as": "Signed Share"
            }
          ],
          "layer": [
            {
              "mark": {"type": "bar", "height": {"band": 0.82}},
              "encoding": {
                "y": {
                  "field": "AgeGroup",
                  "type": "ordinal",
                  "sort": {"field": "AgeOrder", "order": "descending"},
                  "axis": null
                },
                "x": {
                  "field": "Signed Share",
                  "type": "quantitative",
                  "scale": {"domain": [-20, 20], "nice": false},
                  "axis": {
                    "title": "Share of all recipients of that care type (%)",
                    "values": [-15, -10, -5, 0, 5, 10, 15],
                    "labelExpr": "format(abs(datum.value), '.0f') + '%'"
                  }
                },
                "color": {
                  "field": "CareType",
                  "type": "nominal",
                  "scale": {"domain": ["Home care", "Residential care"], "range": ["#0072B2", "#E69F00"]},
                  "legend": null
                },
                "tooltip": [
                  {"field": "CareType", "type": "nominal", "title": "Care type"},
                  {"field": "Sex", "type": "nominal"},
                  {"field": "AgeGroup", "type": "nominal", "title": "Age group"},
                  {"field": "Recipients", "type": "quantitative", "format": ","},
                  {"field": "Share of Care Type", "type": "quantitative", "format": ".1f", "title": "Share of all recipients of this care type (%)"}
                ]
              }
            },
            {
              "data": {"values": [{"x": -10, "t": "◄ Home care"}, {"x": 10, "t": "Residential care ►"}]},
              "mark": {"type": "text", "fontSize": 13, "fontWeight": "bold", "color": "#142D4E", "baseline": "bottom"},
              "encoding": {
                "x": {"field": "x", "type": "quantitative"},
                "y": {"value": -6},
                "text": {"field": "t", "type": "nominal"}
              }
            }
          ]
        }
      ],
      "spacing": 30
    },
    {
      "width": 720,
      "height": 70,
      "transform": [
        {"filter": "datum.AgeOrder >= 9"},
        {
          "aggregate": [{"op": "sum", "field": "Share of Care Type", "as": "Share 90+"}],
          "groupby": ["CareType"]
        },
        {"pivot": "CareType", "value": "Share 90+"},
        {
          "calculate": "'Aged 90 or older: ' + format(datum['Residential care'], '.1f') + '% of residential care recipients, compared with ' + format(datum['Home care'], '.1f') + '% of home care recipients.'",
          "as": "Annotation"
        }
      ],
      "layer": [
        {
          "mark": {"type": "text", "align": "left", "baseline": "top", "fontSize": 14, "fontWeight": "bold", "color": "#142D4E"},
          "encoding": {
            "x": {"value": 0},
            "y": {"value": 0},
            "text": {"field": "Annotation", "type": "nominal"}
          }
        },
        {
          "data": {"values": [{"x": 0}]},
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "top",
            "fontSize": 11,
            "opacity": 0.85,
            "color": "#142D4E",
            "lineHeight": 14,
            "text": [
              "Source: Australian Institute of Health and Welfare (AIHW), GEN Aged Care Data, 30 June 2025.",
              "Each bar is a share of all recipients (men and women together) of that care type, so the two care types can be compared fairly."
            ]
          },
          "encoding": {
            "x": {"value": 0},
            "y": {"value": 36}
          }
        }
      ]
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Inter, Helvetica, Arial, sans-serif",
    "axis": {
      "labelColor": "#142D4E",
      "titleColor": "#142D4E",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "gridColor": "#E6EAF0"
    }
  }
}
