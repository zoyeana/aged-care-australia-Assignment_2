{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 460,
  "data": {
    "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/australia_ageing_slopegraph_2011_2025.csv",
    "format": {
      "type": "csv",
      "parse": {"Year": "number", "Aged65Pct": "number"}
    }
  },
  "transform": [
    {"filter": "datum.Year == 2011 || datum.Year == 2025"},
    {
      "calculate": "datum.Year == 2011 ? datum.Aged65Pct : null",
      "as": "Value 2011"
    },
    {
      "calculate": "datum.Year == 2025 ? datum.Aged65Pct : null",
      "as": "Value 2025"
    },
    {
      "joinaggregate": [
        {"op": "max", "field": "Value 2011", "as": "Pct 2011"},
        {"op": "max", "field": "Value 2025", "as": "Pct 2025"}
      ],
      "groupby": ["State"]
    },
    {"calculate": "datum['Pct 2025'] - datum['Pct 2011']", "as": "Change"},
    {
      "window": [{"op": "dense_rank", "as": "Rank"}],
      "sort": [{"field": "Change", "order": "descending"}]
    },
    {
      "joinaggregate": [
        {"op": "distinct", "field": "State", "as": "State Count"}
      ]
    },
    {"calculate": "datum.Rank == 1", "as": "Is Top"},
    {"calculate": "datum.Year == 2011 ? 0 : 1", "as": "Position"},
    {
      "calculate": "datum.State == 'Australian Capital Territory' ? 'ACT' : datum.State",
      "as": "Label"
    },
    {"calculate": "format(datum.Aged65Pct, '.2f') + '%'", "as": "Value Label"},
    {
      "calculate": "'+' + format(datum.Change, '.2f') + ' pp'",
      "as": "Change Label"
    },
    {
      "calculate": "datum.Rank + ' of ' + datum['State Count']",
      "as": "Rank Label"
    },
    {
      "lookup": "State",
      "from": {
        "data": {
          "values": [
            {"State": "Tasmania", "Nudge 2011": 0.31, "Nudge 2025": 0},
            {"State": "South Australia", "Nudge 2011": -0.31, "Nudge 2025": 0},
            {
              "State": "New South Wales",
              "Nudge 2011": 0.14,
              "Nudge 2025": 0.34
            },
            {"State": "Victoria", "Nudge 2011": -0.24, "Nudge 2025": -0.2},
            {"State": "Queensland", "Nudge 2011": 0, "Nudge 2025": 0.13},
            {"State": "Western Australia", "Nudge 2011": 0, "Nudge 2025": -0.27}
          ]
        },
        "key": "State",
        "fields": ["Nudge 2011", "Nudge 2025"]
      }
    },
    {
      "calculate": "(datum.Year == 2011 ? datum['Nudge 2011'] : datum['Nudge 2025']) || 0",
      "as": "Nudge"
    },
    {"calculate": "datum.Aged65Pct + datum.Nudge", "as": "Label Y"}
  ],
  "encoding": {
    "x": {
      "field": "Position",
      "type": "quantitative",
      "scale": {
        "domain": [0, 1],
        "range": [66, {"expr": "width - (width < 620 ? 196 : 282)"}]
      },
      "axis": null
    },
    "y": {
      "field": "Aged65Pct",
      "type": "quantitative",
      "scale": {"domain": [4.6, 23.2], "nice": false, "zero": false},
      "axis": null
    }
  },
  "layer": [
    {
      "data": {"values": [{"Position": 0}, {"Position": 1}]},
      "mark": {"type": "rule", "color": "#E5EAE8"},
      "encoding": {"y": {"value": 0}, "y2": {"value": 460}}
    },
    {
      "data": {
        "values": [
          {"Position": 0, "Header": "2011"},
          {"Position": 1, "Header": "2025"}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#142D4E",
        "baseline": "bottom"
      },
      "encoding": {"y": {"value": -10}, "text": {"field": "Header"}}
    },
    {
      "data": {"values": [{"Position": 1, "Header": "Change"}]},
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#64748B",
        "align": "right",
        "baseline": "bottom",
        "dx": 270,
        "opacity": {"expr": "width < 620 ? 0 : 1"}
      },
      "encoding": {"y": {"value": -10}, "text": {"field": "Header"}}
    },
    {
      "mark": {"type": "line", "strokeCap": "round"},
      "encoding": {
        "detail": {"field": "State"},
        "order": {"field": "Rank", "sort": "descending"},
        "color": {
          "condition": {"test": "datum['Is Top']", "value": "#D99A62"},
          "value": "#377E88"
        },
        "strokeWidth": {
          "condition": [
            {
              "test": {
                "and": [
                  {"param": "State_hover", "empty": false},
                  "datum['Is Top']"
                ]
              },
              "value": 5
            },
            {"param": "State_hover", "empty": false, "value": 3.4},
            {"test": "datum['Is Top']", "value": 4}
          ],
          "value": 2
        },
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.15
        }
      }
    },
    {
      "params": [
        {
          "name": "State_hover",
          "select": {
            "type": "point",
            "fields": ["State"],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 16,
        "opacity": 0.001,
        "cursor": "pointer"
      },
      "encoding": {
        "detail": {"field": "State"},
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {
            "field": "Pct 2011",
            "type": "quantitative",
            "format": ".2f",
            "title": "Aged 65+ in 2011 (%)"
          },
          {
            "field": "Pct 2025",
            "type": "quantitative",
            "format": ".2f",
            "title": "Aged 65+ in 2025 (%)"
          },
          {
            "field": "Change Label",
            "type": "nominal",
            "title": "Increase (percentage points)"
          },
          {
            "field": "Rank Label",
            "type": "nominal",
            "title": "Rank by increase"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "opacity": 1,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "condition": {"test": "datum['Is Top']", "value": "#D99A62"},
          "value": "#377E88"
        },
        "size": {
          "condition": [
            {"param": "State_hover", "empty": false, "value": 120},
            {"test": "datum['Is Top']", "value": 90}
          ],
          "value": 52
        },
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.15
        }
      }
    },
    {
      "transform": [{"filter": "datum.Nudge != 0 && datum.Year == 2011"}],
      "mark": {
        "type": "rule",
        "color": "#80B5AE",
        "xOffset": -5,
        "x2Offset": -11
      },
      "encoding": {
        "x2": {"field": "Position"},
        "y2": {"field": "Label Y"},
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.2
        }
      }
    },
    {
      "transform": [{"filter": "datum.Nudge != 0 && datum.Year == 2025"}],
      "mark": {
        "type": "rule",
        "color": "#80B5AE",
        "xOffset": 5,
        "x2Offset": 11
      },
      "encoding": {
        "x2": {"field": "Position"},
        "y2": {"field": "Label Y"},
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.2
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2011"}],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "align": "right",
        "baseline": "middle",
        "dx": -14
      },
      "encoding": {
        "y": {"field": "Label Y"},
        "text": {"field": "Value Label"},
        "color": {
          "condition": {"test": "datum['Is Top']", "value": "#142D4E"},
          "value": "#64748B"
        },
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025"}],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "align": "left",
        "baseline": "middle",
        "dx": 14
      },
      "encoding": {
        "y": {"field": "Label Y"},
        "text": {"field": "Value Label"},
        "color": {
          "condition": {"test": "datum['Is Top']", "value": "#142D4E"},
          "value": "#64748B"
        },
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025 && !datum['Is Top']"}],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#142D4E",
        "align": "left",
        "baseline": "middle",
        "dx": 66
      },
      "encoding": {
        "y": {"field": "Label Y"},
        "text": {"field": "Label"},
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025 && datum['Is Top']"}],
      "mark": {
        "type": "text",
        "fontSize": 13,
        "fontWeight": "bold",
        "color": "#142D4E",
        "align": "left",
        "baseline": "middle",
        "dx": 66
      },
      "encoding": {
        "y": {"field": "Label Y"},
        "text": {"field": "Label"},
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025 && datum['Is Top']"}],
      "mark": {
        "type": "rect",
        "color": "#D99A62",
        "cornerRadius": 9,
        "xOffset": 206,
        "x2Offset": 277,
        "yOffset": -10,
        "y2Offset": 10,
        "opacity": {"expr": "width < 620 ? 0 : 0.25"}
      },
      "encoding": {
        "x2": {"field": "Position"},
        "y": {"field": "Label Y"},
        "y2": {"field": "Label Y"}
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025 && !datum['Is Top']"}],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#377E88",
        "align": "right",
        "baseline": "middle",
        "dx": 270
      },
      "encoding": {
        "y": {"field": "Label Y"},
        "text": {"field": "Change Label"},
        "opacity": {
          "condition": {"test": "width < 620", "value": 0},
          "value": 1
        },
        "fillOpacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2025 && datum['Is Top']"}],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#142D4E",
        "align": "right",
        "baseline": "middle",
        "dx": 270
      },
      "encoding": {
        "y": {"field": "Label Y"},
        "text": {"field": "Change Label"},
        "opacity": {
          "condition": {"test": "width < 620", "value": 0},
          "value": 1
        },
        "fillOpacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.25
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.Year == 2011 && datum['Is Top']"},
        {
          "calculate": "datum['Pct 2011'] + 0.12 * datum.Change + 0.25",
          "as": "Line At"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#D99A62",
        "strokeWidth": 1.2,
        "strokeDash": [2, 2]
      },
      "encoding": {
        "x": {"datum": 0.12},
        "y": {"datum": {"expr": "width < 620 ? 22.5 : 20.35"}},
        "y2": {"field": "Line At"},
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.2
        }
      }
    },
    {
      "transform": [{"filter": "datum.Year == 2011 && datum['Is Top']"}],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#142D4E",
        "align": "left",
        "baseline": "middle",
        "dx": 10
      },
      "encoding": {
        "x": {"datum": 0},
        "y": {"datum": {"expr": "width < 620 ? 23.0 : 21.6"}},
        "text": {"value": "Australia’s fastest-ageing state"},
        "opacity": {
          "condition": {"param": "State_hover", "value": 1},
          "value": 0.2
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.Year == 2011 && datum['Is Top']"},
        {
          "calculate": "datum.State + ' gained ' + datum['Change Label'] + ', ' + format(datum['Pct 2011'], '.2f') + '% → ' + format(datum['Pct 2025'], '.2f') + '%'",
          "as": "Note"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#64748B",
        "align": "left",
        "baseline": "middle",
        "dx": 10
      },
      "encoding": {
        "x": {"datum": 0},
        "y": {"datum": 20.85},
        "text": {"field": "Note"},
        "opacity": {
          "condition": [
            {"test": "width < 620", "value": 0},
            {"param": "State_hover", "value": 1}
          ],
          "value": 0.2
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Note": "pp = percentage points (2025 share − 2011 share). Hover a line for details."
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#64748B",
        "align": "left",
        "baseline": "top",
        "limit": {"expr": "width - 8"}
      },
      "encoding": {
        "x": {"value": 0},
        "y": {"value": 474},
        "text": {"field": "Note"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "text": {"color": "#142D4E"}}
}