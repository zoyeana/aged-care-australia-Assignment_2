{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How Do Home Care Package Levels Vary by Age?",
    "subtitle": [
      "Each cell shows the share of one age group's Home Care Package recipients at that level, 30 June 2025.",
      "Darker cells mean a larger share of that age group receives that package level."
    ],
    "anchor": "start",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "color": "#142D4E",
    "subtitleColor": "#142D4E",
    "offset": 12
  },
  "background": "#FFFFFF",
  "width": "container",
  "height": 460,
  "data": {
    "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart08_home_care_packages_age_level_2025.csv"
  },
  "transform": [
    {
      "calculate": "'Level ' + slice(datum.PackageLevel, 6)",
      "as": "Package Level"
    },
    {
      "calculate": "format(datum.PercentageWithinAgeGroup, '.1f') + '%'",
      "as": "Label"
    }
  ],
  "layer": [
    {
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout",
            "fields": [
              "AgeGroup",
              "Package Level"
            ]
          }
        }
      ],
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 3,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "Package Level",
          "type": "ordinal",
          "sort": [
            "Level 1",
            "Level 2",
            "Level 3",
            "Level 4"
          ],
          "axis": {
            "title": "Home Care Package level (Level 1 = basic support, Level 4 = high support)",
            "orient": "bottom",
            "labelAngle": 0,
            "labelFontSize": 13,
            "titleFontSize": 12,
            "ticks": false,
            "domain": false,
            "titlePadding": 12
          }
        },
        "y": {
          "field": "AgeGroup",
          "type": "ordinal",
          "sort": [
            "100+",
            "95–99",
            "90–94",
            "85–89",
            "80–84",
            "75–79",
            "70–74",
            "65–69",
            "60–64",
            "55–59",
            "50–54",
            "0–49"
          ],
          "axis": {
            "title": "Age group (years)",
            "labelFontSize": 12,
            "titleFontSize": 12,
            "ticks": false,
            "domain": false
          }
        },
        "color": {
          "field": "PercentageWithinAgeGroup",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              40,
              80
            ],
            "range": [
              "#EAF4FF",
              "#0072B2",
              "#0A2F57"
            ],
            "clamp": true
          },
          "legend": {
            "title": "Share of age group (%)",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "gradientThickness": 12,
            "values": [
              0,
              20,
              40,
              60,
              80
            ],
            "labelExpr": "datum.label + '%'",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "titleLimit": 240
          }
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "value": 1
          },
          "value": 0.82
        },
        "strokeWidth": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 3
          },
          "value": 3
        },
        "tooltip": [
          {
            "field": "AgeGroup",
            "type": "nominal",
            "title": "Age group"
          },
          {
            "field": "Package Level",
            "type": "nominal",
            "title": "Package level"
          },
          {
            "field": "Recipients",
            "type": "quantitative",
            "format": ",",
            "title": "Recipients"
          },
          {
            "field": "AgeGroupTotal",
            "type": "quantitative",
            "format": ",",
            "title": "Total recipients in age group"
          },
          {
            "field": "PercentageWithinAgeGroup",
            "type": "quantitative",
            "format": ".1f",
            "title": "Share of age group (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "Package Level",
          "type": "ordinal",
          "sort": [
            "Level 1",
            "Level 2",
            "Level 3",
            "Level 4"
          ]
        },
        "y": {
          "field": "AgeGroup",
          "type": "ordinal",
          "sort": [
            "100+",
            "95–99",
            "90–94",
            "85–89",
            "80–84",
            "75–79",
            "70–74",
            "65–69",
            "60–64",
            "55–59",
            "50–54",
            "0–49"
          ]
        },
        "text": {
          "field": "Label",
          "type": "nominal"
        },
        "color": {
          "condition": {
            "test": "datum.PercentageWithinAgeGroup >= 30",
            "value": "#FFFFFF"
          },
          "value": "#142D4E"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Inter, Helvetica, Arial, sans-serif",
    "axis": {
      "labelColor": "#142D4E",
      "titleColor": "#142D4E"
    },
    "legend": {
      "labelColor": "#142D4E",
      "titleColor": "#142D4E"
    }
  }
}
