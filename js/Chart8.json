{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "background": "white",
  "padding": 5,
  "width": 800,
  "height": 560,
  "title": {
    "text": "Where Are Australia's Residential Aged Care Facilities Concentrated?",
    "frame": "group"
  },
  "style": ["view", "cell"],
  "data": [
    {
      "name": "source_0",
      "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/australia_states.topojson",
      "format": {"type": "topojson", "feature": "australia_states"}
    },
    {"name": "source_2", "values": [{"a": 0}], "format": {}},
    {
      "name": "source_3",
      "values": [{"t": "= 5 residential aged care facilities"}]
    },
    {
      "name": "source_4",
      "values": [{"t": "Groups with fewer than 5 facilities are not shown."}]
    },
    {
      "name": "source_1",
      "url": "https://raw.githubusercontent.com/zoyeana/aged-care-australia-Assignment_2/refs/heads/main/data/chart07_residential_facility_dot_map_2025.csv",
      "format": {"type": "csv", "delimiter": ","},
      "transform": [
        {
          "type": "formula",
          "expr": "{'NSW':'New South Wales','VIC':'Victoria','QLD':'Queensland','WA':'Western Australia','SA':'South Australia','TAS':'Tasmania','ACT':'Australian Capital Territory','NT':'Northern Territory'}[datum.State]",
          "as": "State name"
        },
        {
          "type": "formula",
          "expr": "floor(datum.FacilitiesRepresented / 5)",
          "as": "Dots"
        },
        {"type": "filter", "expr": "datum.Dots >= 1"},
        {"type": "formula", "expr": "sequence(0, datum.Dots)", "as": "k"},
        {"type": "flatten", "fields": ["k"], "as": ["k"]},
        {
          "type": "formula",
          "expr": "datum.Dots == 1 ? 0 : (datum.k % 2 == 0 ? -1 : 1) * 5",
          "as": "dx"
        },
        {
          "type": "formula",
          "expr": "datum.Dots == 1 ? 0 : (floor(datum.k / 2) % 2 == 0 ? -1 : 1) * (datum.Dots == 2 ? 0 : 5)",
          "as": "dy"
        },
        {
          "type": "geojson",
          "fields": ["Longitude", "Latitude"],
          "signal": "layer_1_geojson_0"
        },
        {
          "type": "geopoint",
          "projection": "projection",
          "fields": ["Longitude", "Latitude"],
          "as": ["layer_1_x", "layer_1_y"]
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "size": {"signal": "[width, height]"},
      "fit": {"signal": "[data('source_0'), layer_1_geojson_0]"},
      "type": "mercator"
    }
  ],
  "marks": [
    {
      "name": "layer_0_marks",
      "type": "shape",
      "style": ["geoshape"],
      "from": {"data": "source_0"},
      "encode": {
        "update": {
          "fill": {"value": "#F4F8FC"},
          "stroke": {"value": "#B8CADB"},
          "ariaRoleDescription": {"value": "geoshape"}
        }
      },
      "transform": [{"type": "geoshape", "projection": "projection"}]
    },
    {
      "name": "layer_1_marks",
      "type": "symbol",
      "style": ["circle"],
      "from": {"data": "source_1"},
      "encode": {
        "update": {
          "opacity": {"value": 0.9},
          "stroke": {"value": "#FFFFFF"},
          "strokeWidth": {"value": 0.5},
          "size": {"value": 70},
          "fill": {"value": "#0072B2"},
          "tooltip": {
            "signal": "{\"State or territory\": isValid(datum[\"State name\"]) ? isArray(datum[\"State name\"]) ? join(datum[\"State name\"], '\\n') : datum[\"State name\"] : \"\"+datum[\"State name\"], \"Region (Statistical Area Level 3)\": isValid(datum[\"SA3Name\"]) ? isArray(datum[\"SA3Name\"]) ? join(datum[\"SA3Name\"], '\\n') : datum[\"SA3Name\"] : \"\"+datum[\"SA3Name\"], \"Facilities in this group\": format(datum[\"FacilitiesRepresented\"], \"\"), \"Dots shown (1 dot = 5 facilities)\": format(datum[\"Dots\"], \"\"), \"Total facilities in this region\": format(datum[\"SA3FacilityTotal\"], \"\")}"
          },
          "ariaRoleDescription": {"value": "circle"},
          "description": {
            "signal": "\"Longitude: \" + (format(datum[\"Longitude\"], \"\")) + \"; Latitude: \" + (format(datum[\"Latitude\"], \"\")) + \"; dx: \" + (format(datum[\"dx\"], \"\")) + \"; dy: \" + (format(datum[\"dy\"], \"\")) + \"; State or territory: \" + (isValid(datum[\"State name\"]) ? isArray(datum[\"State name\"]) ? join(datum[\"State name\"], ' ') : datum[\"State name\"] : \"\"+datum[\"State name\"]) + \"; Region (Statistical Area Level 3): \" + (isValid(datum[\"SA3Name\"]) ? isArray(datum[\"SA3Name\"]) ? join(datum[\"SA3Name\"], ' ') : datum[\"SA3Name\"] : \"\"+datum[\"SA3Name\"]) + \"; Facilities in this group: \" + (format(datum[\"FacilitiesRepresented\"], \"\")) + \"; Dots shown (1 dot = 5 facilities): \" + (format(datum[\"Dots\"], \"\")) + \"; Total facilities in this region: \" + (format(datum[\"SA3FacilityTotal\"], \"\"))"
          },
          "x": {"field": "layer_1_x"},
          "y": {"field": "layer_1_y"},
          "shape": {"value": "circle"}
        }
      }
    },
    {
      "name": "layer_2_marks",
      "type": "rect",
      "style": ["rect"],
      "from": {"data": "source_2"},
      "encode": {
        "update": {
          "opacity": {"value": 0.92},
          "stroke": {"value": "#B8CADB"},
          "cornerRadius": {"value": 6},
          "fill": {"value": "#FFFFFF"},
          "x": {"value": 10},
          "x2": {"value": 395},
          "y": {"value": 490},
          "y2": {"value": 550}
        }
      }
    },
    {
      "name": "layer_3_marks",
      "type": "symbol",
      "style": ["circle"],
      "from": {"data": "source_2"},
      "encode": {
        "update": {
          "opacity": {"value": 0.9},
          "fill": {"value": "#0072B2"},
          "size": {"value": 70},
          "ariaRoleDescription": {"value": "circle"},
          "x": {"value": 26},
          "y": {"value": 508},
          "shape": {"value": "circle"}
        }
      }
    },
    {
      "name": "layer_4_marks",
      "type": "text",
      "style": ["text"],
      "from": {"data": "source_3"},
      "encode": {
        "update": {
          "align": {"value": "left"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"},
          "fill": {"value": "#142D4E"},
          "description": {
            "signal": "\"t: \" + (isValid(datum[\"t\"]) ? isArray(datum[\"t\"]) ? join(datum[\"t\"], ' ') : datum[\"t\"] : \"\"+datum[\"t\"])"
          },
          "x": {"value": 40},
          "y": {"value": 508},
          "text": {
            "signal": "isValid(datum[\"t\"]) ? datum[\"t\"] : \"\"+datum[\"t\"]"
          }
        }
      }
    },
    {
      "name": "layer_5_marks",
      "type": "text",
      "style": ["text"],
      "from": {"data": "source_4"},
      "encode": {
        "update": {
          "align": {"value": "left"},
          "baseline": {"value": "middle"},
          "fontSize": {"value": 12},
          "fill": {"value": "#142D4E"},
          "description": {
            "signal": "\"t: \" + (isValid(datum[\"t\"]) ? isArray(datum[\"t\"]) ? join(datum[\"t\"], ' ') : datum[\"t\"] : \"\"+datum[\"t\"])"
          },
          "x": {"value": 20},
          "y": {"value": 531},
          "text": {
            "signal": "isValid(datum[\"t\"]) ? datum[\"t\"] : \"\"+datum[\"t\"]"
          }
        }
      }
    }
  ],
  "config": {}
}